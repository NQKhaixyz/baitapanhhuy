# Không commit API key thật. PowerShell: $env:GEMINI_API_KEY = "..."
GEMINI_API_KEY=
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# rules | hybrid | llm; hybrid uses LLM only for ambiguous queries
RAG_CLASSIFIER=hybrid
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
# Ngưỡng cosine có thể tinh chỉnh sau khi chạy eval.py
RAG_RETRIEVAL_THRESHOLD=0.18
RAG_TOP_K=3
